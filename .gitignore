# Make Git ignore the following types of file, to avoid having them committed by mistake, cluttering the repo.
# Gams list file output does not need to be versioned, and neither do log files etc that GAMS (or the editor) may produce

# GAMS output files
*.lst
*.log
*.gdx
*.lxi
*.ref
*.bak
*.exp
*.g0*

# Temporary / editor files
*.~gm
*.tmp
*.temp
Thumbs.db
Desktop.ini
.vscode/

# Generated folders
/output/
/reports/
/225*